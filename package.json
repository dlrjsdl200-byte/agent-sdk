{
  "name": "@chain-ops/agent-sdk",
  "version": "0.1.2",
  "description": "x402 (V1 + V2) payment client for AI agents with ERC-8004 identity registration and trust lookup. One call: 402 → sign USDC authorization → retry.",
  "keywords": [
    "x402",
    "erc-8004",
    "ai-agent",
    "agentic",
    "agent-economy",
    "agent-payments",
    "pay-per-call",
    "mcp",
    "web3",
    "micropayments",
    "usdc",
    "stablecoin",
    "base",
    "trustless-agents"
  ],
  "license": "MIT",
  "author": "chain-ops.xyz",
  "homepage": "https://chain-ops.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlrjsdl200-byte/agent-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/dlrjsdl200-byte/agent-sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
